{
  "name": "fieldwork",
  "display_name": "Fieldwork",
  "version": "0.1.0",
  "publisher": "Fortune",
  "repository": "https://github.com/fortunexbt/fieldwork-plugins",
  "website": "https://fortunexbt.github.io/fieldwork-plugins",
  "plugins": [
    {
      "id": "frame-lab",
      "name": "Minecraft Performance Lab",
      "short": "Compare frame pacing",
      "description": "Compare compatible Minecraft frame captures, catch invalid measurements, and inspect a supported local benchmark setup. Inspect frame-time tails and true 1% lows; differing profiles are flagged before a winner is reported. Live capture requires a supported macOS Minecraft installation; saved evidence can be analyzed in an execution-capable environment.",
      "category": "Gaming",
      "color": "#28624B",
      "keywords": [
        "minecraft",
        "shaders",
        "fps",
        "benchmark"
      ],
      "capabilities": [
        "Analyze frame captures",
        "Compare measured runs",
        "Diagnose local setup"
      ],
      "prompts": [
        "Compare these Minecraft captures and show which run is smoother.",
        "Check whether my Minecraft benchmark results are a fair comparison.",
        "Help me prepare a supported local Minecraft benchmark."
      ],
      "runtime": "Python 3.11+. Live capture: supported macOS Minecraft, Java and Minescript.",
      "entrypoint": "frame_lab.py",
      "demo": {
        "headline": "Compare two frame captures and name the smoother one",
        "sandbox": "browser",
        "steps": [
          {
            "title": "Analyze the built-in synthetic captures",
            "argv": [
              "demo"
            ],
            "stats": [
              {
                "label": "Preferred run",
                "path": "data.comparison.preferred_run"
              },
              {
                "label": "Fair comparison",
                "path": "data.comparison.comparable"
              },
              {
                "label": "Frame intervals each",
                "path": "data.comparison.runs[0].frame_intervals"
              }
            ],
            "table": {
              "path": "data.comparison.runs",
              "columns": [
                {
                  "label": "Capture",
                  "path": "run"
                },
                {
                  "label": "Average FPS",
                  "path": "average_fps"
                },
                {
                  "label": "p95",
                  "path": "p95_ms",
                  "suffix": " ms"
                },
                {
                  "label": "p99",
                  "path": "p99_ms",
                  "suffix": " ms"
                },
                {
                  "label": "1% low",
                  "path": "one_percent_low_fps",
                  "suffix": " fps"
                },
                {
                  "label": "Valid",
                  "path": "valid"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "fit-to-upload",
      "name": "Fit to Upload",
      "short": "Fit the limit. Keep the moment",
      "description": "Probe a video, calculate a plan for a chosen file-size limit, and encode a verified copy with FFmpeg. Preserve duration and original files, keep audio when feasible, and see the exact output size and encoding choices. Requires file execution access plus FFmpeg and FFprobe.",
      "category": "Productivity",
      "color": "#B14F32",
      "keywords": [
        "video",
        "compression",
        "upload",
        "ffmpeg"
      ],
      "capabilities": [
        "Inspect media streams",
        "Plan size-limited encoding",
        "Verify output bytes"
      ],
      "prompts": [
        "Make this video fit under 25 MB and preserve the audio if possible.",
        "Show me a compression plan for this file before encoding it.",
        "Check whether this video already fits a 500 MB upload limit."
      ],
      "runtime": "Python 3.11+, FFmpeg and FFprobe, with access to the selected files.",
      "entrypoint": "fit_to_upload.py",
      "demo": {
        "headline": "Budget a 390 KB clip down to a 120 KB upload limit",
        "sandbox": "replayed",
        "sandbox_note": "A browser cannot host FFmpeg. The probe step replays recorded output from real ffprobe and ffmpeg on this exact clip; the byte budget below is calculated live.",
        "inputs": [
          {
            "path": "clip.mp4",
            "source": "samples/fit-to-upload/clip.mp4"
          }
        ],
        "recorded_binaries": "samples/fit-to-upload/recorded-binaries.json",
        "steps": [
          {
            "title": "Plan the encode without writing a file",
            "argv": [
              "plan",
              "--input",
              "clip.mp4",
              "--output",
              "upload.mp4",
              "--max-bytes",
              "120000"
            ],
            "stats": [
              {
                "label": "Source",
                "path": "data.source_bytes",
                "format": "bytes"
              },
              {
                "label": "Limit",
                "path": "data.max_bytes",
                "format": "bytes"
              },
              {
                "label": "Plan",
                "path": "data.action"
              },
              {
                "label": "Video budget",
                "path": "data.video_bitrate_bps",
                "format": "bitrate"
              }
            ],
            "table": {
              "path": "data.source_streams",
              "columns": [
                {
                  "label": "Stream",
                  "path": "type"
                },
                {
                  "label": "Codec",
                  "path": "codec"
                },
                {
                  "label": "Measured bitrate",
                  "path": "bitrate_bps",
                  "format": "bitrate"
                },
                {
                  "label": "Duration",
                  "path": "duration_seconds",
                  "suffix": " s"
                }
              ]
            },
            "downloads": [
              {
                "path": "clip.mp4",
                "label": "The sample clip",
                "type": "video/mp4"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "tablebeam",
      "name": "Tablebeam",
      "short": "Exact answers. Source rows.",
      "description": "Inspect CSV files and answer aggregate, filter and grouping questions with exact decimal arithmetic. Keep long identifiers and raw values intact, inspect the source rows behind an answer, and export reusable results. Calculation runs locally in the execution environment; it does not call an AI provider.",
      "category": "Data & Analytics",
      "color": "#325AA0",
      "keywords": [
        "csv",
        "spreadsheet",
        "decimal",
        "analysis"
      ],
      "capabilities": [
        "Profile CSV files",
        "Calculate exact aggregates",
        "Export source-linked results"
      ],
      "prompts": [
        "Total the amounts in this CSV and show the source rows.",
        "Group this CSV by category without rounding away precision.",
        "Check this CSV for missing values and ambiguous numeric columns."
      ],
      "runtime": "Python 3.11+ in a file execution environment.",
      "entrypoint": "tablebeam.py",
      "demo": {
        "headline": "Group a CSV with exact decimal arithmetic",
        "sandbox": "browser",
        "inputs": [
          {
            "path": "demo-sales.csv",
            "source": "plugins/tablebeam/skills/tablebeam/assets/demo-sales.csv"
          },
          {
            "path": "demo-query.json",
            "source": "plugins/tablebeam/skills/tablebeam/assets/demo-query.json"
          }
        ],
        "steps": [
          {
            "title": "Sum revenue per owner for the North region",
            "argv": [
              "query",
              "demo-sales.csv",
              "--spec",
              "demo-query.json"
            ],
            "stats": [
              {
                "label": "Matched rows",
                "path": "data.matched_row_count"
              },
              {
                "label": "Groups",
                "path": "data.result_group_count"
              },
              {
                "label": "Source lines",
                "path": "data.source_coverage.source_line_ranges.range_count",
                "suffix": " ranges"
              }
            ],
            "table": {
              "path": "data.result_rows",
              "columns": [
                {
                  "label": "Owner",
                  "path": "group.owner"
                },
                {
                  "label": "Revenue sum",
                  "path": "value"
                },
                {
                  "label": "Rows",
                  "path": "rows"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "shipproof",
      "name": "ShipProof",
      "short": "Check what actually shipped",
      "description": "Compare expected release assets and content markers with a supplied live URL. Report matches, stale bytes, missing resources and checks that could not be completed. Prepare a repository handoff with revision and working-tree evidence. HTTP verification does not claim visual or full user-flow validation.",
      "category": "Developer Tools",
      "color": "#67519B",
      "keywords": [
        "deployment",
        "release",
        "verification",
        "handoff"
      ],
      "capabilities": [
        "Verify served assets",
        "Check release markers",
        "Prepare repository handoffs"
      ],
      "prompts": [
        "Check whether this URL serves the release in my build folder.",
        "Compare the live JavaScript file with my expected SHA-256.",
        "Create a handoff for this repository without exporting secrets."
      ],
      "runtime": "Python 3.11+, network access for URL checks, Git for repository handoffs.",
      "entrypoint": "shipproof.py",
      "demo": {
        "headline": "Check that a deployed file matches the committed copy",
        "sandbox": "network",
        "sandbox_note": "This downloads a real file from this site over HTTP and hashes it against the copy committed in the repository. Python has no sockets in a browser, so the request goes through XMLHttpRequest; the comparison is the tool's own.",
        "inputs": [
          {
            "path": "app.js",
            "source": "plugins/shipproof/skills/shipproof/examples/release/assets/app.js"
          }
        ],
        "steps": [
          {
            "title": "Fetch the served asset and compare it with the expected bytes",
            "argv": [
              "verify",
              "--url",
              "{{site}}samples/shipproof/app.js",
              "--asset",
              "app.js",
              "--marker",
              "demo-release-2026-09"
            ],
            "stats": [
              {
                "label": "Verdict",
                "path": "data.resources[0].result"
              },
              {
                "label": "HTTP status",
                "path": "data.resources[0].status_code"
              },
              {
                "label": "Evidence checks",
                "path": "data.resources[0].checks",
                "format": "count"
              }
            ],
            "table": {
              "path": "data.resources[0].checks",
              "columns": [
                {
                  "label": "Check",
                  "path": "check"
                },
                {
                  "label": "Result",
                  "path": "result"
                },
                {
                  "label": "Expected",
                  "path": "expected",
                  "truncate": 24
                },
                {
                  "label": "Served",
                  "path": "actual",
                  "truncate": 24
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "safe-tidy",
      "name": "Safe Tidy",
      "short": "Organize with a way back",
      "description": "Inspect a chosen directory, find byte-identical files, and preview a file organization plan. Apply reviewed moves with a receipt and undo unchanged moves later. Never deletes files or overwrites conflicts. Skips repositories, symlinks and unsupported cloud placeholders rather than treating them as clutter.",
      "category": "Productivity",
      "color": "#9C711F",
      "keywords": [
        "files",
        "organization",
        "duplicates",
        "undo"
      ],
      "capabilities": [
        "Inspect a selected folder",
        "Preview file moves",
        "Undo verified moves"
      ],
      "prompts": [
        "Preview how to organize this folder; keep all the original files.",
        "Find byte-identical files in this directory without deleting anything.",
        "Undo the unchanged moves in this Safe Tidy receipt."
      ],
      "runtime": "Python 3.11+ with access to the chosen local directory.",
      "entrypoint": "safe_tidy.py",
      "demo": {
        "headline": "Find duplicate files and write a reviewable move plan",
        "sandbox": "browser",
        "sandbox_note": "Applying a plan needs hard links, which the browser's in-memory filesystem does not have, so this demo stops at the plan. Installed locally, apply writes an undo receipt before it moves anything.",
        "creates": [
          {
            "path": "inbox/notes.txt",
            "text": "a synthetic note\n"
          },
          {
            "path": "inbox/notes-copy.txt",
            "text": "a synthetic note\n"
          },
          {
            "path": "inbox/totals.csv",
            "text": "item,total\nexample,12\n"
          },
          {
            "path": "inbox/read-me.md",
            "text": "# Sample inbox\n\nThree files, one exact duplicate.\n"
          }
        ],
        "steps": [
          {
            "title": "Hash every direct file and group exact duplicates",
            "argv": [
              "inventory",
              "--root",
              "inbox"
            ],
            "stats": [
              {
                "label": "Files hashed",
                "path": "data.files_scanned"
              },
              {
                "label": "Bytes hashed",
                "path": "data.bytes_hashed",
                "format": "bytes"
              },
              {
                "label": "Duplicate groups",
                "path": "data.duplicate_groups",
                "format": "count"
              }
            ],
            "table": {
              "path": "data.files",
              "columns": [
                {
                  "label": "File",
                  "path": "path"
                },
                {
                  "label": "Bytes",
                  "path": "size_bytes"
                },
                {
                  "label": "SHA-256",
                  "path": "sha256",
                  "truncate": 12
                }
              ]
            }
          },
          {
            "title": "Write the move plan without moving anything",
            "argv": [
              "plan",
              "--root",
              "inbox",
              "--output",
              "plan.json"
            ],
            "stats": [
              {
                "label": "Planned moves",
                "path": "data.moves",
                "format": "count"
              },
              {
                "label": "Conflicts",
                "path": "data.conflicts",
                "format": "count"
              },
              {
                "label": "Plan SHA-256",
                "path": "data.plan_sha256",
                "truncate": 12
              }
            ],
            "table": {
              "path": "data.moves",
              "columns": [
                {
                  "label": "Source",
                  "path": "source"
                },
                {
                  "label": "Proposed destination",
                  "path": "destination"
                },
                {
                  "label": "Bytes",
                  "path": "size_bytes"
                }
              ]
            },
            "downloads": [
              {
                "path": "plan.json",
                "label": "The plan file",
                "type": "application/json"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "cad-rescue",
      "name": "CAD Rescue",
      "short": "Understand a difficult drawing",
      "description": "Inspect DXF, SVG and DWG drawings, report layers, units and extents, and create a safe geometry preview. DWG uses a separately installed LibreDWG Web runtime; DXF recovery validates an exported copy while preserving the original. A preview is not a certified CAD repair.",
      "category": "Design",
      "color": "#297A88",
      "keywords": [
        "cad",
        "dxf",
        "dwg",
        "svg"
      ],
      "capabilities": [
        "Inspect drawing geometry",
        "Report import problems",
        "Export a safe preview"
      ],
      "prompts": [
        "Inspect this drawing and show its layers, units and bounds.",
        "Create a safe preview of this DXF and explain missing geometry.",
        "Diagnose why this drawing imports at the wrong scale."
      ],
      "runtime": "Python 3.11+ and ezdxf. DWG additionally requires Node.js and the documented LibreDWG Web runtime.",
      "entrypoint": "cad_rescue.py",
      "license": "GPL-3.0-only",
      "demo": {
        "headline": "Open a DXF floor plan and draw a preview from its geometry",
        "sandbox": "browser",
        "sandbox_note": "DXF parsing needs ezdxf, so the first run downloads that package into the browser. It takes a few seconds once.",
        "requires": [
          "ezdxf==1.4.5"
        ],
        "inputs": [
          {
            "path": "demo-plan.dxf",
            "source": "plugins/cad-rescue/skills/cad-rescue/assets/demo-plan.dxf"
          }
        ],
        "steps": [
          {
            "title": "Inspect the drawing",
            "argv": [
              "inspect",
              "--input",
              "demo-plan.dxf"
            ],
            "stats": [
              {
                "label": "Entities",
                "path": "data.entity_count"
              },
              {
                "label": "Layers",
                "path": "data.layers",
                "format": "count"
              },
              {
                "label": "Units",
                "path": "data.units.name"
              },
              {
                "label": "Parser",
                "path": "data.parser.version",
                "prefix": "ezdxf "
              }
            ],
            "table": {
              "path": "data.layers",
              "columns": [
                {
                  "label": "Layer",
                  "path": "_key"
                },
                {
                  "label": "Entities",
                  "path": "entities"
                }
              ]
            }
          },
          {
            "title": "Render an SVG preview",
            "argv": [
              "preview",
              "--input",
              "demo-plan.dxf",
              "--output",
              "plan.svg"
            ],
            "stats": [
              {
                "label": "Paths written",
                "path": "data.paths_written"
              },
              {
                "label": "Preview bytes",
                "path": "data.receipt.size_bytes",
                "format": "bytes"
              },
              {
                "label": "SHA-256",
                "path": "data.receipt.sha256",
                "truncate": 12
              }
            ],
            "image": {
              "path": "plan.svg",
              "caption": "Drawn from the DXF entities, in your browser"
            },
            "downloads": [
              {
                "path": "plan.svg",
                "label": "The generated SVG",
                "type": "image/svg+xml"
              },
              {
                "path": "demo-plan.dxf",
                "label": "The source DXF",
                "type": "image/vnd.dxf"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ci-spend-check",
      "name": "CI Spend Check",
      "short": "Find repeated CI waste",
      "description": "Analyze GitHub Actions runs to find repeated failures, cancelled work and long-running workflows. Show the calculations and links behind each recommendation. Runtime is not billed cost; billing estimates require real usage data. This plugin does not disable workflows.",
      "category": "Developer Tools",
      "color": "#AF465F",
      "keywords": [
        "github",
        "actions",
        "ci",
        "runtime"
      ],
      "capabilities": [
        "Analyze Actions runs",
        "Rank repeated failure patterns",
        "Explain runtime totals"
      ],
      "prompts": [
        "Find recurring failures and wasted runtime in these GitHub Actions runs.",
        "Audit this repository's recent workflow runs without changing settings.",
        "Show which CI workflows deserve attention and link the evidence."
      ],
      "runtime": "Python 3.11+. Live GitHub reads use an already authenticated GitHub CLI.",
      "entrypoint": "ci_spend_check.py",
      "demo": {
        "headline": "Read exported GitHub Actions runs and find the repeated failures",
        "sandbox": "browser",
        "inputs": [
          {
            "path": "sample-runs.json",
            "source": "plugins/ci-spend-check/skills/ci-spend-check/assets/sample-runs.json"
          }
        ],
        "steps": [
          {
            "title": "Analyze the exported run history",
            "argv": [
              "analyze",
              "sample-runs.json"
            ],
            "stats": [
              {
                "label": "Run attempts",
                "path": "data.runs_analyzed"
              },
              {
                "label": "Workflows",
                "path": "data.workflows",
                "format": "count"
              },
              {
                "label": "Input SHA-256",
                "path": "data.input_sha256",
                "truncate": 12
              }
            ],
            "table": {
              "path": "data.workflows",
              "columns": [
                {
                  "label": "Workflow",
                  "path": "name"
                },
                {
                  "label": "Attempts",
                  "path": "runs"
                },
                {
                  "label": "Failed",
                  "path": "failed_runs"
                },
                {
                  "label": "Run elapsed",
                  "path": "run_elapsed_minutes",
                  "suffix": " min"
                },
                {
                  "label": "Job time",
                  "path": "measured_job_minutes",
                  "suffix": " min"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "asset-check",
      "name": "Asset Check",
      "short": "Know what your 3D scene costs",
      "description": "Inspect glTF and GLB exports for geometry counts, textures, materials, external resources and required extensions. Compare the actual asset against explicit budgets and identify missing resources. Reports do not substitute for frame-rate measurements on target devices.",
      "category": "Design",
      "color": "#427060",
      "keywords": [
        "gltf",
        "glb",
        "blender",
        "3d"
      ],
      "capabilities": [
        "Inspect 3D asset structure",
        "Check resource budgets",
        "Identify missing resources"
      ],
      "prompts": [
        "Inspect this GLB before I ship it to the web.",
        "Check this glTF against a 100,000-triangle and 20 MB budget.",
        "Find missing textures and unsupported extensions in this 3D export."
      ],
      "runtime": "Python 3.11+ with access to the selected glTF/GLB and its local resources.",
      "entrypoint": "asset_check.py",
      "demo": {
