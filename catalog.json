{
  "name": "fieldwork",
  "display_name": "Fieldwork",
  "version": "0.1.0",
  "publisher": "Fortune",
  "repository": "https://github.com/fortunexbt/fieldwork-plugins",
  "website": "https://fortunexbt.github.io/fieldwork-plugins",
  "plugins": [
    {
      "id": "frame-lab",
      "name": "Minecraft Performance Lab",
      "short": "Compare frame pacing",
      "description": "Compare compatible Minecraft frame captures, catch invalid measurements, and inspect a supported local benchmark setup. Inspect frame-time tails and true 1% lows; differing profiles are flagged before a winner is reported. Live capture requires a supported macOS Minecraft installation; saved evidence can be analyzed in an execution-capable environment.",
      "category": "Gaming",
      "color": "#28624B",
      "keywords": [
        "minecraft",
        "shaders",
        "fps",
        "benchmark"
      ],
      "capabilities": [
        "Analyze frame captures",
        "Compare measured runs",
        "Diagnose local setup"
      ],
      "prompts": [
        "Compare these Minecraft captures and show which run is smoother.",
        "Check whether my Minecraft benchmark results are a fair comparison.",
        "Help me prepare a supported local Minecraft benchmark."
      ],
      "runtime": "Python 3.11+. Live capture: supported macOS Minecraft, Java and Minescript.",
      "entrypoint": "frame_lab.py",
      "demo": {
        "headline": "Check whether a real Minecraft frame capture can be ranked, and measure it anyway",
        "sandbox": "browser",
        "sandbox_note": "This harness records its route as route.csv and route.txt. Frame Lab ranks a capture only when it has the route.json sidecar from the Frame Bench harness, so it rejects this one and still reports every measurement.",
        "input": {
          "about": "Capture mmc-r12-112954-0 from the peak-v2 control set: Minecraft 26.3, a 21-second scripted flight, recorded on 2026-10-06.",
          "credit": "From the author's minecraft-apple-silicon-framework, MIT.",
          "url": "https://github.com/fortunexbt/minecraft-apple-silicon-framework"
        },
        "inputs": [
          {
            "path": "bench-output/mmc-r12-112954-0-done.txt",
            "source": "samples/minecraft-capture/mmc-r12-112954-0-done.txt"
          },
          {
            "path": "bench-output/mmc-r12-112954-0-frames.csv",
            "source": "samples/minecraft-capture/mmc-r12-112954-0-frames.csv"
          },
          {
            "path": "bench-output/mmc-r12-112954-0-route.csv",
            "source": "samples/minecraft-capture/mmc-r12-112954-0-route.csv"
          },
          {
            "path": "bench-output/mmc-r12-112954-0-route.txt",
            "source": "samples/minecraft-capture/mmc-r12-112954-0-route.txt"
          },
          {
            "path": "bench-output/mmc-r12-112954-0-start.txt",
            "source": "samples/minecraft-capture/mmc-r12-112954-0-start.txt"
          },
          {
            "path": "bench-output/mmc-r12-112954-0-warmup.csv",
            "source": "samples/minecraft-capture/mmc-r12-112954-0-warmup.csv"
          }
        ],
        "steps": [
          {
            "title": "Validate the capture and measure its frame intervals",
            "argv": [
              "inspect",
              "--evidence-dir",
              "bench-output",
              "--run",
              "mmc-r12-112954-0"
            ],
            "stats": [
              {
                "label": "Accepted for ranking",
                "path": "data.valid"
              },
              {
                "label": "Reason",
                "path": "data.invalid_reasons[0]"
              },
              {
                "label": "Frame intervals",
                "path": "data.frame_intervals"
              },
              {
                "label": "Average FPS",
                "path": "data.average_fps"
              },
              {
                "label": "p99 frame time",
                "path": "data.p99_ms",
                "suffix": " ms"
              },
              {
                "label": "1% low",
                "path": "data.one_percent_low_fps",
                "suffix": " fps"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "fit-to-upload",
      "name": "Fit to Upload",
      "short": "Fit the limit. Keep the moment",
      "description": "Probe a video, calculate a plan for a chosen file-size limit, and encode a verified copy with FFmpeg. Preserve duration and original files, keep audio when feasible, and see the exact output size and encoding choices. Requires file execution access plus FFmpeg and FFprobe.",
      "category": "Productivity",
      "color": "#B14F32",
      "keywords": [
        "video",
        "compression",
        "upload",
        "ffmpeg"
      ],
      "capabilities": [
        "Inspect media streams",
        "Plan size-limited encoding",
        "Verify output bytes"
      ],
      "prompts": [
        "Make this video fit under 25 MB and preserve the audio if possible.",
        "Show me a compression plan for this file before encoding it.",
        "Check whether this video already fits a 500 MB upload limit."
      ],
      "runtime": "Python 3.11+, FFmpeg and FFprobe, with access to the selected files.",
      "entrypoint": "fit_to_upload.py",
      "demo": {
        "headline": "Plan how to fit a 562 kB film clip under a 250 kB upload limit",
        "sandbox": "replayed",
        "sandbox_note": "A browser cannot host FFmpeg. The probe step replays what real ffprobe and ffmpeg printed for this exact clip, recorded by scripts/make_samples.py. The byte budget is calculated live from that metadata and the clip's size.",
        "input": {
          "about": "Five seconds of Big Buck Bunny (2:00 to 2:05), cut from the 320x180 release with stream copy, so every frame is the original encode.",
          "credit": "© Blender Foundation, CC BY 3.0.",
          "url": "https://peach.blender.org/"
        },
        "inputs": [
          {
            "path": "clip.mp4",
            "source": "samples/fit-to-upload/clip.mp4"
          }
        ],
        "recorded_binaries": "samples/fit-to-upload/recorded-binaries.json",
        "steps": [
          {
            "title": "Plan the encode without writing a file",
            "argv": [
              "plan",
              "--input",
              "clip.mp4",
              "--output",
              "upload.mp4",
              "--max-bytes",
              "250000"
            ],
            "stats": [
              {
                "label": "Source",
                "path": "data.source_bytes",
                "format": "bytes"
              },
              {
                "label": "Limit",
                "path": "data.max_bytes",
                "format": "bytes"
              },
              {
                "label": "Plan",
                "path": "data.action"
              },
              {
                "label": "Video budget",
                "path": "data.video_bitrate_bps",
                "format": "bitrate"
              }
            ],
            "table": {
              "path": "data.source_streams",
              "columns": [
                {
                  "label": "Stream",
                  "path": "type"
                },
                {
                  "label": "Codec",
                  "path": "codec"
                },
                {
                  "label": "Measured bitrate",
                  "path": "bitrate_bps",
                  "format": "bitrate"
                },
                {
                  "label": "Duration",
                  "path": "duration_seconds",
                  "suffix": " s"
                }
              ]
            },
            "downloads": [
              {
                "path": "clip.mp4",
                "label": "The clip",
                "type": "video/mp4"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "tablebeam",
      "name": "Tablebeam",
      "short": "Exact answers. Source rows.",
      "description": "Inspect CSV files and answer aggregate, filter and grouping questions with exact decimal arithmetic. Keep long identifiers and raw values intact, inspect the source rows behind an answer, and export reusable results. Calculation runs locally in the execution environment; it does not call an AI provider.",
      "category": "Data & Analytics",
      "color": "#325AA0",
      "keywords": [
        "csv",
        "spreadsheet",
        "decimal",
        "analysis"
      ],
      "capabilities": [
        "Profile CSV files",
        "Calculate exact aggregates",
        "Export source-linked results"
      ],
      "prompts": [
        "Total the amounts in this CSV and show the source rows.",
        "Group this CSV by category without rounding away precision.",
        "Check this CSV for missing values and ambiguous numeric columns."
      ],
      "runtime": "Python 3.11+ in a file execution environment.",
      "entrypoint": "tablebeam.py",
      "demo": {
        "headline": "Average penguin body mass by species, with exact decimal arithmetic",
        "sandbox": "browser",
        "sandbox_note": "Two penguins have NA for body mass. Tablebeam reads NA as text, not as a missing value, so the query drops those rows by name instead of guessing.",
        "input": {
          "about": "Palmer Penguins: 344 penguins measured at Palmer Station, Antarctica, 2007 to 2009.",
          "credit": "Horst, Hill and Gorman; data collected by Gorman, Williams and Fraser. CC0.",
          "url": "https://github.com/allisonhorst/palmerpenguins"
        },
        "inputs": [
          {
            "path": "penguins.csv",
            "source": "samples/tablebeam/penguins.csv"
          },
          {
            "path": "penguins-query.json",
            "source": "samples/tablebeam/penguins-query.json"
          }
        ],
        "steps": [
          {
            "title": "Skip the rows with no body mass and average body_mass_g per species",
            "argv": [
              "query",
              "penguins.csv",
              "--spec",
              "penguins-query.json"
            ],
            "stats": [
              {
                "label": "Matched rows",
                "path": "data.matched_row_count"
              },
              {
                "label": "Groups",
                "path": "data.result_group_count"
              },
              {
                "label": "Source lines",
                "path": "data.source_coverage.source_line_ranges.range_count",
                "suffix": " ranges"
              }
            ],
            "table": {
              "path": "data.result_rows",
              "columns": [
                {
                  "label": "Species",
                  "path": "group.species"
                },
                {
                  "label": "Mean body mass (g)",
                  "path": "value.decimal",
                  "truncate": 14
                },
                {
                  "label": "Exact",
                  "path": "value.exact"
                },
                {
                  "label": "Rows",
                  "path": "rows"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "shipproof",
      "name": "ShipProof",
      "short": "Check what actually shipped",
      "description": "Compare expected release assets and content markers with a supplied live URL. Report matches, stale bytes, missing resources and checks that could not be completed. Prepare a repository handoff with revision and working-tree evidence. HTTP verification does not claim visual or full user-flow validation.",
      "category": "Developer Tools",
      "color": "#67519B",
      "keywords": [
        "deployment",
        "release",
        "verification",
        "handoff"
      ],
      "capabilities": [
        "Verify served assets",
        "Check release markers",
        "Prepare repository handoffs"
      ],
      "prompts": [
        "Check whether this URL serves the release in my build folder.",
        "Compare the live JavaScript file with my expected SHA-256.",
        "Create a handoff for this repository without exporting secrets."
      ],
      "runtime": "Python 3.11+, network access for URL checks, Git for repository handoffs.",
      "entrypoint": "shipproof.py",
      "demo": {
        "headline": "Check that jsDelivr serves the exact Pyodide file published on npm",
        "sandbox": "network",
        "sandbox_note": "This page runs on that Pyodide release. Python has no sockets in a browser, so the request to jsDelivr goes through XMLHttpRequest; the hashing and the comparison are the tool's own.",
        "input": {
          "about": "The expected file is pyodide.mjs from the npm package pyodide@314.0.7.",
          "credit": "Pyodide contributors, MPL 2.0.",
          "url": "https://www.npmjs.com/package/pyodide/v/314.0.7"
        },
        "inputs": [
          {
            "path": "pyodide.mjs",
            "source": "samples/shipproof/pyodide.mjs"
          }
        ],
        "steps": [
          {
            "title": "Fetch the served file and compare it with the npm copy",
            "argv": [
              "verify",
              "--url",
              "https://cdn.jsdelivr.net/pyodide/v314.0.7/full/pyodide.mjs",
              "--asset",
              "pyodide.mjs",
              "--marker",
              "314.0.7",
              "--header",
              "Content-Type:text/javascript; charset=utf-8"
            ],
            "stats": [
              {
                "label": "Verdict",
                "path": "data.resources[0].result"
              },
              {
                "label": "HTTP status",
                "path": "data.resources[0].status_code"
              },
              {
                "label": "Evidence checks",
                "path": "data.resources[0].checks",
                "format": "count"
              }
            ],
            "table": {
              "path": "data.resources[0].checks",
              "columns": [
                {
                  "label": "Check",
                  "path": "check"
                },
                {
                  "label": "Result",
                  "path": "result"
                },
                {
                  "label": "Expected",
                  "path": "expected",
                  "truncate": 24
                },
                {
                  "label": "Served",
                  "path": "actual",
                  "truncate": 24
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "safe-tidy",
      "name": "Safe Tidy",
      "short": "Organize with a way back",
      "description": "Inspect a chosen directory, find byte-identical files, and preview a file organization plan. Apply reviewed moves with a receipt and undo unchanged moves later. Never deletes files or overwrites conflicts. Skips repositories, symlinks and unsupported cloud placeholders rather than treating them as clutter.",
      "category": "Productivity",
      "color": "#9C711F",
      "keywords": [
        "files",
        "organization",
        "duplicates",
        "undo"
      ],
      "capabilities": [
        "Inspect a selected folder",
        "Preview file moves",
        "Undo verified moves"
      ],
      "prompts": [
        "Preview how to organize this folder; keep all the original files.",
        "Find byte-identical files in this directory without deleting anything.",
        "Undo the unchanged moves in this Safe Tidy receipt."
      ],
      "runtime": "Python 3.11+ with access to the chosen local directory.",
      "entrypoint": "safe_tidy.py",
      "demo": {
        "headline": "Find the duplicates in a real benchmark output folder and plan a tidy-up",
        "sandbox": "browser",
        "sandbox_note": "Applying a plan needs hard links, which the browser's in-memory filesystem does not have, so this demo stops at the plan. Installed locally, apply writes an undo receipt before it moves anything.",
        "input": {
          "about": "The 12 files one capture session wrote, copied unchanged: two repeats of the same Minecraft route, which wrote identical start files.",
          "credit": "From the author's minecraft-apple-silicon-framework, MIT.",
          "url": "https://github.com/fortunexbt/minecraft-apple-silicon-framework"
        },
        "inputs": [
          {
            "path": "bench-output/mmc-r12-112954-0-done.txt",
            "source": "samples/minecraft-capture/mmc-r12-112954-0-done.txt"
          },
          {
            "path": "bench-output/mmc-r12-112954-0-frames.csv",
            "source": "samples/minecraft-capture/mmc-r12-112954-0-frames.csv"
          },
          {
            "path": "bench-output/mmc-r12-112954-0-route.csv",
            "source": "samples/minecraft-capture/mmc-r12-112954-0-route.csv"
          },
          {
            "path": "bench-output/mmc-r12-112954-0-route.txt",
            "source": "samples/minecraft-capture/mmc-r12-112954-0-route.txt"
          },
          {
            "path": "bench-output/mmc-r12-112954-0-start.txt",
            "source": "samples/minecraft-capture/mmc-r12-112954-0-start.txt"
          },
          {
            "path": "bench-output/mmc-r12-112954-0-warmup.csv",
            "source": "samples/minecraft-capture/mmc-r12-112954-0-warmup.csv"
          },
          {
            "path": "bench-output/mmc-r12-112954-1-done.txt",
            "source": "samples/minecraft-capture/mmc-r12-112954-1-done.txt"
          },
          {
            "path": "bench-output/mmc-r12-112954-1-frames.csv",
            "source": "samples/minecraft-capture/mmc-r12-112954-1-frames.csv"
          },
          {
            "path": "bench-output/mmc-r12-112954-1-route.csv",
            "source": "samples/minecraft-capture/mmc-r12-112954-1-route.csv"
          },
          {
            "path": "bench-output/mmc-r12-112954-1-route.txt",
            "source": "samples/minecraft-capture/mmc-r12-112954-1-route.txt"
          },
          {
            "path": "bench-output/mmc-r12-112954-1-start.txt",
            "source": "samples/minecraft-capture/mmc-r12-112954-1-start.txt"
          },
          {
            "path": "bench-output/mmc-r12-112954-1-warmup.csv",
            "source": "samples/minecraft-capture/mmc-r12-112954-1-warmup.csv"
          }
        ],
        "steps": [
          {
            "title": "Hash every direct file and group exact duplicates",
            "argv": [
              "inventory",
              "--root",
              "bench-output"
            ],
            "stats": [
              {
                "label": "Files hashed",
                "path": "data.files_scanned"
              },
              {
                "label": "Bytes hashed",
                "path": "data.bytes_hashed",
                "format": "bytes"
              },
              {
                "label": "Duplicate groups",
                "path": "data.duplicate_groups",
                "format": "count"
              }
            ],
            "table": {
              "path": "data.files",
              "columns": [
                {
                  "label": "File",
                  "path": "path"
                },
                {
                  "label": "Bytes",
                  "path": "size_bytes"
                },
                {
                  "label": "SHA-256",
                  "path": "sha256",
                  "truncate": 12
                }
              ]
            }
