            "stats": [
              {
                "label": "Planned moves",
                "path": "data.moves",
                "format": "count"
              },
              {
                "label": "Conflicts",
                "path": "data.conflicts",
                "format": "count"
              },
              {
                "label": "Plan SHA-256",
                "path": "data.plan_sha256",
                "truncate": 12
              }
            ],
            "table": {
              "path": "data.moves",
              "columns": [
                {
                  "label": "Source",
                  "path": "source"
                },
                {
                  "label": "Proposed destination",
                  "path": "destination"
                },
                {
                  "label": "Bytes",
                  "path": "size_bytes"
                }
              ]
            },
            "downloads": [
              {
                "path": "plan.json",
                "label": "The plan file",
                "type": "application/json"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "cad-rescue",
      "name": "CAD Rescue",
      "short": "Understand a difficult drawing",
      "description": "Inspect DXF, SVG and DWG drawings, report layers, units and extents, and create a safe geometry preview. DWG uses a separately installed LibreDWG Web runtime; DXF recovery validates an exported copy while preserving the original. A preview is not a certified CAD repair.",
      "category": "Design",
      "color": "#297A88",
      "keywords": [
        "cad",
        "dxf",
        "dwg",
        "svg"
      ],
      "capabilities": [
        "Inspect drawing geometry",
        "Report import problems",
        "Export a safe preview"
      ],
      "prompts": [
        "Inspect this drawing and show its layers, units and bounds.",
        "Create a safe preview of this DXF and explain missing geometry.",
        "Diagnose why this drawing imports at the wrong scale."
      ],
      "runtime": "Python 3.11+ and ezdxf. DWG additionally requires Node.js and the documented LibreDWG Web runtime.",
      "entrypoint": "cad_rescue.py",
      "license": "GPL-3.0-only",
      "demo": {
        "headline": "Open a real DXF and draw a preview from its geometry",
        "sandbox": "browser",
        "sandbox_note": "DXF parsing needs ezdxf, so the first run downloads that package into the browser. It takes a few seconds once.",
        "requires": [
          "ezdxf==1.4.5"
        ],
        "input": {
          "about": "usa.dxf from the ezdxf examples: US borders drawn as 59 polylines.",
          "credit": "Manfred Moitzi and the ezdxf contributors, MIT.",
          "url": "https://github.com/mozman/ezdxf/blob/master/examples/addons/drawing/data/usa.dxf"
        },
        "inputs": [
          {
            "path": "usa.dxf",
            "source": "samples/cad-rescue/usa.dxf"
          }
        ],
        "steps": [
          {
            "title": "Inspect the drawing",
            "argv": [
              "inspect",
              "--input",
              "usa.dxf"
            ],
            "stats": [
              {
                "label": "Entities",
                "path": "data.entity_count"
              },
              {
                "label": "Layers",
                "path": "data.layers",
                "format": "count"
              },
              {
                "label": "Units",
                "path": "data.units.name"
              },
              {
                "label": "Parser",
                "path": "data.parser.version",
                "prefix": "ezdxf "
              }
            ],
            "table": {
              "path": "data.layers",
              "columns": [
                {
                  "label": "Layer",
                  "path": "_key"
                },
                {
                  "label": "Entities",
                  "path": "entities"
                }
              ]
            }
          },
          {
            "title": "Render an SVG preview",
            "argv": [
              "preview",
              "--input",
              "usa.dxf",
              "--output",
              "usa.svg"
            ],
            "stats": [
              {
                "label": "Paths written",
                "path": "data.paths_written"
              },
              {
                "label": "Preview bytes",
                "path": "data.receipt.size_bytes",
                "format": "bytes"
              },
              {
                "label": "SHA-256",
                "path": "data.receipt.sha256",
                "truncate": 12
              }
            ],
            "image": {
              "path": "usa.svg",
              "caption": "Drawn from the DXF entities, in your browser"
            },
            "downloads": [
              {
                "path": "usa.svg",
                "label": "The generated SVG",
                "type": "image/svg+xml"
              },
              {
                "path": "usa.dxf",
                "label": "The source DXF",
                "type": "image/vnd.dxf"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ci-spend-check",
      "name": "CI Spend Check",
      "short": "Find repeated CI waste",
      "description": "Analyze GitHub Actions runs to find repeated failures, cancelled work and long-running workflows. Show the calculations and links behind each recommendation. Runtime is not billed cost; billing estimates require real usage data. This plugin does not disable workflows.",
      "category": "Developer Tools",
      "color": "#AF465F",
      "keywords": [
        "github",
        "actions",
        "ci",
        "runtime"
      ],
      "capabilities": [
        "Analyze Actions runs",
        "Rank repeated failure patterns",
        "Explain runtime totals"
      ],
      "prompts": [
        "Find recurring failures and wasted runtime in these GitHub Actions runs.",
        "Audit this repository's recent workflow runs without changing settings.",
        "Show which CI workflows deserve attention and link the evidence."
      ],
      "runtime": "Python 3.11+. Live GitHub reads use an already authenticated GitHub CLI.",
      "entrypoint": "ci_spend_check.py",
      "demo": {
        "headline": "Find the repeated failures in a real GitHub Actions history",
        "sandbox": "browser",
        "input": {
          "about": "Every Actions run of the public repo fortunexbt/barter, saved on 2026-10-23 by ci_spend_check.py fetch fortunexbt/barter --limit 100 --jobs.",
          "credit": "Public GitHub API data from the author's MIT-licensed repo.",
          "url": "https://github.com/fortunexbt/barter/actions"
        },
        "inputs": [
          {
            "path": "barter-runs.json",
            "source": "samples/ci-spend-check/barter-runs.json"
          }
        ],
        "steps": [
          {
            "title": "Analyze the saved run history",
            "argv": [
              "analyze",
              "barter-runs.json"
            ],
            "stats": [
              {
                "label": "Run attempts",
                "path": "data.runs_analyzed"
              },
              {
                "label": "Workflows",
                "path": "data.workflows",
                "format": "count"
              },
              {
                "label": "Input SHA-256",
                "path": "data.input_sha256",
                "truncate": 12
              }
            ],
            "table": {
              "path": "data.workflows",
              "columns": [
                {
